#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "so101_new_calib"
    doc = """Generated from Composed Stage of root layer /tmp/tmpn3iw5i0r/so101_new_calib.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_so101_new_calib_m_xogghi/usdex_so101_new_calib/so101_new_calib.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_so101_new_calib_m_xogghi/temp_so101_new_calib/so101_new_calib.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "so101_new_calib" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </so101_new_calib/Physics/root_joint>,
        </so101_new_calib/Physics/Rotation>,
        </so101_new_calib/Physics/Pitch>,
        </so101_new_calib/Physics/Elbow>,
        </so101_new_calib/Physics/Wrist_Pitch>,
        </so101_new_calib/Physics/Wrist_Roll>,
        </so101_new_calib/Physics/Jaw>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </so101_new_calib/Geometry/base>,
        </so101_new_calib/Geometry/base/shoulder>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/gripper>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/gripper/jaw>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "shoulder" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "upper_arm" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "lower_arm" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "wrist" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "gripper" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "jaw" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Jaw" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Wrist_Roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Wrist_Pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Elbow" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Rotation" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

